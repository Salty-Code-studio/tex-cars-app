# Dependencies
/node_modules

# Next.js build output
/.next
/out

# Secrets — NEVER commit. Only .env.example is tracked.
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*

# OS / editor
.DS_Store
*.pem
.idea
.vscode

# Local SQLite / data
*.sqlite
*.db
.dev-db/

# TypeScript incremental build state
*.tsbuildinfo
.mcp.json

# local object-storage driver (STORAGE_DRIVER=local)
.dev-storage
# test-only storage dir (src/test/setup.ts pins LOCAL_STORAGE_DIR here so the
# suite's afterAll cleanup can never touch a real dev/demo server's .dev-storage)
.test-storage
